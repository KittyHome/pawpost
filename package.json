{
  "name": "pawpost",
  "private": true,
  "description": "Self-hosted, source-available cold email outreach: your mailboxes, your lists, your server.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "prettier --check . && turbo run typecheck lint test",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:generate": "pnpm --filter @pawpost/db generate",
    "db:migrate": "pnpm --filter @pawpost/db migrate",
    "smtp:dev": "tsx scripts/dev-smtp.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "user:reset-link": "tsx scripts/reset-link.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/smtp-server": "^3",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.10",
    "smtp-server": "3.19.23",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "^5"
  }
}
