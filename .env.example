# --- Required ---
# Postgres connection. `pnpm db:dev` starts a local one and prints this URL.
DATABASE_URL=postgres://pawpost:pawpost@localhost:54329/pawpost

# Public URL of the web app. Used in unsubscribe links, so it must be reachable
# by recipients in production (https://outreach.example.com).
APP_URL=http://localhost:3000

# Encrypts stored mailbox passwords and API keys, and signs login sessions.
# At least 32 characters. Changing it makes stored passwords unreadable.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# --- Accounts ---
# Optional: create the owner account automatically on first start.
# Leave both empty to create it in the browser on the first-run setup page.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional: require this value on the first-run setup page, so nobody else
# can claim the owner account on a public server before you do.
# SETUP_TOKEN=

# Optional: SMTP connection for invitation and password reset emails.
# Without it, Pawpost shows the links to copy and share yourself.
# SYSTEM_SMTP_URL=smtps://user:password@smtp.example.com:465
# SYSTEM_EMAIL_FROM=Pawpost <no-reply@example.com>

# --- AI (optional) ---
# A key saved in Settings -> AI takes precedence over this one.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# For OpenAI-compatible gateways:
# OPENAI_BASE_URL=

# HTTP(S) proxy for OpenAI API calls only (mail traffic never uses it).
# Typical for local testing behind a proxy, e.g. http://127.0.0.1:7890
# Falls back to HTTPS_PROXY when unset.
OPENAI_PROXY_URL=

# --- Worker tuning (optional) ---
# DISPATCH_INTERVAL_SECONDS=20
# INBOX_SYNC_INTERVAL_SECONDS=120
# RUN_MIGRATIONS=true
# Accept self-signed TLS certificates from your SMTP server.
# SMTP_ALLOW_SELF_SIGNED=false
# LOG_LEVEL=info
